# ============================================================
# CampsPilot SaaS API — environment template.
# Copy to backend_saas/.env and fill in real values.
# This file contains NO real secrets and is committed to the repo.
# ============================================================

APP_NAME=CampsPilot SaaS API
# development (local), staging (Render), or whatever future environments
# need — currently only used in startup logging, no behavior branches on it.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL connection string. Required — the app fails to start without it.
#
# Local Supabase stack (see ../supabase/, `supabase db start` from repo root):
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# Supabase Cloud — the "CampsPilot SaaS" project (ref wkmckfbzhmihyfwiekct,
# eu-central-1), NOT the "Sommercamps"/KSV project:
#   Supabase Dashboard → Settings → Database → Connection string → URI
#   (Transaction Pooler recommended)
#   sslmode=require is applied automatically for any non-localhost host
#   (see app/db.py) — no need to add it here yourself.
# On Render (staging/production): set this in the Dashboard's Environment
# tab, never in this file, never in render.yaml (which marks it sync:false
# for exactly that reason).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated extra allowed CORS origins, appended to the built-in
# http://localhost:3000 default (see app/config.py::Settings.cors_origins).
# Empty until a real frontend exists — never set this to "*".
# Example once a Vercel frontend is deployed:
#   CORS_ORIGINS_EXTRA=https://campspilot.vercel.app
CORS_ORIGINS_EXTRA=
