{
  "permissions": {
    "deny": [
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "PowerShell(git push*)",
      "PowerShell(gh pr merge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-prod.ps1"],
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
