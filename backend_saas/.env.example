# ============================================================
# CampsPilot SaaS API — environment template.
# Copy to backend_saas/.env and fill in real values.
# This file contains NO real secrets and is committed to the repo.
# ============================================================

APP_NAME=CampsPilot SaaS API
# development (local), staging (Render), or whatever future environments
# need — currently only used in startup logging, no behavior branches on it.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL connection string. Required — the app fails to start without it.
#
# Local Supabase stack (see ../supabase/, `supabase db start` from repo root):
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# Supabase Cloud — the "CampsPilot SaaS" project (ref wkmckfbzhmihyfwiekct,
# eu-central-1), NOT the "Sommercamps"/KSV project:
#   Supabase Dashboard → Settings → Database → Connection string
#   -> use the "Transaction pooler" tab, NOT "Direct connection".
#
#   Two real deploy failures already hit here (CP-S407), both worth
#   avoiding on purpose:
#   1. The dashboard shows the password as a literal placeholder,
#      e.g. [YOUR-PASSWORD] — replace the whole bracketed part with the
#      real password, don't paste it as-is (the app now rejects this
#      with a clear error at startup either way, but don't rely on that).
#   2. "Direct connection" (db.<ref>.supabase.co) resolves IPv6-only
#      unless you've bought the IPv4 add-on. Most PaaS platforms
#      (Render included) have no outbound IPv6 route, so that host
#      fails with "Network is unreachable" — not a credentials problem.
#      "Transaction pooler" (aws-<n>-<region>.pooler.supabase.com:6543,
#      username postgres.<project-ref> — note the different username
#      format too) is IPv4-compatible and works everywhere.
#
#   sslmode=require is applied automatically for any non-localhost host
#   (see app/db.py) — no need to add it here yourself.
# On Render (staging/production): set this in the Dashboard's Environment
# tab, never in this file, never in render.yaml (which marks it sync:false
# for exactly that reason).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated extra allowed CORS origins, appended to the built-in
# http://localhost:3000 default (see app/config.py::Settings.cors_origins).
# Empty until a real frontend exists — never set this to "*".
# Example once a Vercel frontend is deployed:
#   CORS_ORIGINS_EXTRA=https://campspilot.vercel.app
CORS_ORIGINS_EXTRA=

# Platform accounts (feat/platform-foundation, see app/supabase_auth.py,
# app/auth_deps.py, README.md "Admin / Onboarding"). Replaces the previous
# ADMIN_PASSWORD/JWT_SECRET password scheme — every admin request now
# carries a real Supabase Auth access token.
#
# Get these from Supabase Dashboard -> Settings -> API, for the
# "CampsPilot SaaS" project (ref wkmckfbzhmihyfwiekct) — never KSV's or
# JK's Supabase project.
#
# SUPABASE_URL and SUPABASE_ANON_KEY are required — the app fails to start
# without them (every admin request needs them to verify who's calling).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=change-me
#
# SUPABASE_SERVICE_ROLE_KEY is optional at boot, but required for:
#   - scripts/create_platform_user.py (creating the first platform_owner)
#   - POST /admin/organizations/{slug}/members (assigning an org_admin by
#     email looks the account up via the Supabase Admin API)
# Full-DB-bypass power — never expose this to a frontend, never commit a
# real value anywhere.
SUPABASE_SERVICE_ROLE_KEY=change-me-too
