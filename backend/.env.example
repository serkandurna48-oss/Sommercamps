# ============================================================
# KSV Baunatal Sommercamp Backend – Umgebungsvariablen
# Kopieren als .env und echte Werte eintragen.
# Diese Datei enthält KEINE echten Secrets und ist im Repo.
# ============================================================

# Supabase – PostgreSQL Connection String
# Zu finden unter: Supabase → Settings → Database → Connection string → URI
# Variante: Transaction Pooler, Port 6543
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres

# Admin-Passwort für /admin/login im Browser
# Wähle ein starkes Passwort, gib es deinem Kollegen – kein API-Key nötig.
ADMIN_PASSWORD=hier-ein-starkes-passwort-setzen

# Geheimschlüssel zum Signieren der JWT-Session-Tokens
# Generieren mit: openssl rand -hex 32
JWT_SECRET=hier-einen-langen-zufaelligen-string-setzen

# Gültigkeit eines Session-Tokens in Stunden (optional, Standard: 24)
# TOKEN_EXPIRE_HOURS=24

# Zusätzliche erlaubte CORS-Origins (kommagetrennt)
# Für Produktion: Vercel-URL des Frontends eintragen
# CORS_ORIGINS_EXTRA=https://deine-app.vercel.app

# ── Club-Identität (CP-S301-light) ──────────────────────────
# Optional; ohne diese Vars verhält sich das Backend exakt wie heute (KSV-Defaults).
# CLUB_NAME=KSV Baunatal
# CLUB_SUBTITLE=Fußballschule
# CAMP_YEAR=2026
# Eingetragener Vereinsname für die Copyright-Zeile in E-Mails (kann von CLUB_NAME abweichen)
# CLUB_LEGAL_NAME=KSV Baunatal e.V.

# ── Stripe ──────────────────────────────────────────────────
# Stripe Secret Key (Dashboard → Developers → API keys)
# Test-Schlüssel beginnen mit sk_test_, Live-Schlüssel mit sk_live_
# STRIPE_SECRET_KEY=sk_test_...

# Stripe Webhook Secret (Dashboard → Webhooks → dein Endpoint → Signing secret)
# Wird zur Signatur-Verifikation eingehender Webhook-Events genutzt.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Campbeitrag in Cent (muss mit dem Preis im Stripe-Produkt übereinstimmen)
# Beispiel: 14900 = 149,00 €
# Wird von GET /config ausgeliefert; fehlt dieser Wert, liefert /config und /checkout HTTP 503.
# STRIPE_PRICE_CENTS=14900

# ── E-Mail (Brevo) ───────────────────────────────────────────
# Ohne BREVO_API_KEY oder EMAIL_FROM wird der Mailversand übersprungen
# (die Anmeldung wird trotzdem gespeichert – kein Blocker).

# Brevo API Key (app.brevo.com → Account → SMTP & API → API Keys)
# BREVO_API_KEY=xkeysib-...

# Absender-E-Mail-Adresse (muss in Brevo verifiziert sein)
# EMAIL_FROM=info@ksv-baunatal.de

# Absendername (erscheint im Posteingang)
# EMAIL_FROM_NAME=Fußballschule KSV Baunatal

# Kontakt-E-Mail im Mailtext (für Rückfragen der Eltern)
# CONTACT_EMAIL=info@ksv-baunatal.de

# Reply-To der Bestätigungsmail (optional; Standard: CONTACT_EMAIL)
# EMAIL_REPLY_TO=info@ksv-baunatal.de

# ── Bankverbindung (für Überweisungshinweis in der Bestätigungsmail) ──
# Fehlt eine dieser Variablen, zeigt die Mail statt der Bankdaten einen
# Hinweis, dass sich der Verein mit den Zahlungsinformationen meldet.
# BANK_ACCOUNT_HOLDER=KSV Baunatal e.V.
# BANK_IBAN=DE00 0000 0000 0000 0000 00
# BANK_BIC=XXXXXXXX
# BANK_NAME=Sparkasse Baunatal

# ── Frontend-URL ─────────────────────────────────────────────
# Vollständige URL des Frontends – für Stripe-Redirect nach Checkout
# Lokal: http://localhost:3000 | Produktion: https://deine-app.vercel.app
# FRONTEND_URL=http://localhost:3000

# ── Zusätzliche CORS-Origins ────────────────────────────────
# Für Produktion: Vercel-URL des Frontends eintragen (kommagetrennt)
# CORS_ORIGINS_EXTRA=https://deine-app.vercel.app

# ── Trainingsanfragen (CP-JK-101) ───────────────────────────
# NUR auf dem JK-Service setzen. Ohne diese Variable wird die Route
# /inquiries gar nicht registriert — auf dem KSV-Service existiert sie
# damit nicht, und die dort fehlende Tabelle kann nichts auslösen.
# Voraussetzung: migration_jk101_training_inquiries.sql im Supabase-Projekt
# des jeweiligen Mandanten eingespielt.
# INQUIRIES_ENABLED=true

# Zieladresse für die Benachrichtigung bei neuer Anfrage.
# Reply-To der Mail ist die E-Mail des Elternteils — eine Antwort aus dem
# Postfach geht damit direkt an die richtige Person.
# INQUIRY_NOTIFY_EMAIL=info@jk-performance-academy.de

# Optionale Allowlist der Themen, kommagetrennt. Leer lassen heißt: keine
# Allowlist, dann erzwingt eine neue Programmauswahl im Frontend kein
# Backend-Deployment. Wird sie gesetzt, muss sie zu registrationTopics in
# frontend/app/lib/siteContent.jk.ts passen.
# INQUIRY_TOPICS=Individualtraining,Kleingruppentraining,Camp bei FSK Vollmarshausen,Camp bei TSV Wolfsanger,5 Freunde,Messday,Spieleranalyse
