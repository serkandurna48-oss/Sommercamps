# URL des FastAPI-Backends (ohne trailing slash)
# Lokal: http://localhost:8000
# Produktion (Render): https://deine-app.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe Online-Zahlung aktivieren (true = Button sichtbar, false/leer = Hinweis "bald verfügbar")
# Nur auf true setzen, wenn Stripe vollständig konfiguriert und getestet ist.
NEXT_PUBLIC_STRIPE_ENABLED=false

# ── Club-Identität (CP-S301-light) ──────────────────────────
# Optional; ohne diese Vars verhält sich die App exakt wie heute (KSV-Defaults).
# NEXT_PUBLIC_CLUB_NAME=KSV Baunatal
# NEXT_PUBLIC_CLUB_SUBTITLE=Fußballschule
# NEXT_PUBLIC_CONTACT_NAME=Ergün Ünal
# NEXT_PUBLIC_CONTACT_EMAIL=Erguen.uenal@fussball.ksv-baunatal.de
# NEXT_PUBLIC_CONTACT_PHONE=0170 9927281
# NEXT_PUBLIC_VENUE_NAME=Parkstadion Baunatal
# NEXT_PUBLIC_LOGO_SRC=/logo.svg

# ── Aktiver Club-Draft (CP-S308-light) ───────────────────────
# Nur lokal/preview, NICHT in Produktion setzen. Schaltet auf den kompletten
# JK-Performance-Academy-Konfigurationssatz um (siehe frontend/app/lib/clubConfig.jk.tsx).
# Ohne diese Var (oder jeder andere Wert als "jk") bleibt alles beim KSV-Verhalten.
# NEXT_PUBLIC_ACTIVE_CLUB=jk

# ── CampsPilot SaaS Staging-Pilot (CP-S408) ──────────────────
# Basis-URL des NEUEN, separaten backend_saas-Backends (Render-Staging-Service),
# NICHT dieselbe wie NEXT_PUBLIC_API_URL (das bleibt das KSV/JK-Legacy-Backend).
# Public/kein Secret — gleiche Vertrauensstufe wie NEXT_PUBLIC_API_URL.
# Wird ausschließlich von app/pilot/[org]/ verwendet, betrifft KSV/JK nicht.
# Lokal: http://localhost:8000 (falls backend_saas lokal läuft, sonst leer lassen)
# Staging (Render): https://campspilot-saas-backend.onrender.com
# NEXT_PUBLIC_SAAS_API_URL=http://localhost:8000
